# This repository lives inside a SpiritVale installation. Deny everything at
# the game root, then allow only the maintained public source tree.
/*
!/.gitattributes
!/.gitignore
!/README.md
!/VERSION
!/CHANGELOG.md
!/.github/
!/.codex-localization-tools/

/.codex-localization-tools/*

# Runtime plugin and executable test harnesses.
!/.codex-localization-tools/SpiritVale.RuntimeLocalization/
!/.codex-localization-tools/SpiritVale.RuntimeLocalization/**
!/.codex-localization-tools/SpiritVale.RuntimeLocalization.Tests/
!/.codex-localization-tools/SpiritVale.RuntimeLocalization.Tests/**
!/.codex-localization-tools/SpiritVale.BilingualDisplay.Tests/
!/.codex-localization-tools/SpiritVale.BilingualDisplay.Tests/**
!/.codex-localization-tools/SpiritVale.MarketSearch.Tests/
!/.codex-localization-tools/SpiritVale.MarketSearch.Tests/**

# Maintainer skills and their deterministic control scripts.
!/.codex-localization-tools/skills/
/.codex-localization-tools/skills/*
!/.codex-localization-tools/skills/update-spiritvale-localization/
!/.codex-localization-tools/skills/update-spiritvale-localization/**
!/.codex-localization-tools/skills/package-spiritvale-localization/
!/.codex-localization-tools/skills/package-spiritvale-localization/**

# Installer source. Generated payloads, packages, and self-test workspaces stay local.
!/.codex-localization-tools/installer/
/.codex-localization-tools/installer/**
!/.codex-localization-tools/installer/app.manifest
!/.codex-localization-tools/installer/Build-Payload.ps1
!/.codex-localization-tools/installer/compatibility-policy.json
!/.codex-localization-tools/installer/MainForm.cs
!/.codex-localization-tools/installer/PatchService.cs
!/.codex-localization-tools/installer/Program.cs
!/.codex-localization-tools/installer/Publish.ps1
!/.codex-localization-tools/installer/Publish-Compatibility.ps1
!/.codex-localization-tools/installer/README.md
!/.codex-localization-tools/installer/SpiritVale.ChinesePatch.Installer.csproj
!/.codex-localization-tools/installer/StartupDiagnostics.cs
!/.codex-localization-tools/installer/THIRD_PARTY_NOTICES.txt
!/.codex-localization-tools/installer/licenses/
!/.codex-localization-tools/installer/licenses/**

# Frozen compatibility metadata is a build input, not current release identity.
!/.codex-localization-tools/installer/staging/
!/.codex-localization-tools/installer/staging/compat-v1.2.21-build-24266225/
!/.codex-localization-tools/installer/staging/compat-v1.2.21-build-24266225/compatibility-manifest.json

# Maintained dictionary generator inputs.
!/.codex-localization-tools/apply_game_data_localization.py
!/.codex-localization-tools/bilingual-map-entities.json
!/.codex-localization-tools/generate_runtime_dictionary.py
!/.codex-localization-tools/glossary-translations.json
!/.codex-localization-tools/market-search-concept-aliases.json
!/.codex-localization-tools/market-search-keyword-overrides.json
!/.codex-localization-tools/market-search-keyword-preferences.json
!/.codex-localization-tools/missing-zh-clean.tsv
!/.codex-localization-tools/missing-zh-final.tsv
!/.codex-localization-tools/missing-zh-reviewed.json
!/.codex-localization-tools/missing-zh-reviewed-source-overrides.json
!/.codex-localization-tools/mmo-quality-overrides.json
!/.codex-localization-tools/online-translations.json
!/.codex-localization-tools/remaining-source-translations.json
!/.codex-localization-tools/reviewed-item-name-components.json
!/.codex-localization-tools/runtime-manual-overrides.json
!/.codex-localization-tools/runtime_name_aliases.py

# Maintained tests.
!/.codex-localization-tools/tests/
/.codex-localization-tools/tests/*
!/.codex-localization-tools/tests/Test-SpiritValeReleaseMetadata.ps1
!/.codex-localization-tools/tests/test_bilingual_entity_catalog.py

# Canonical generated review/release inputs. Candidate variants and screenshots are local evidence.
!/.codex-localization-tools/artifacts/
/.codex-localization-tools/artifacts/*
!/.codex-localization-tools/artifacts/bilingual-entity-catalog.audit.json
!/.codex-localization-tools/artifacts/bilingual-entity-catalog.tsv
!/.codex-localization-tools/artifacts/live-verification.json
!/.codex-localization-tools/artifacts/localized-corpus.tsv
!/.codex-localization-tools/artifacts/mixed-description-residuals.tsv
!/.codex-localization-tools/artifacts/runtime-dictionary-conflicts.tsv
!/.codex-localization-tools/artifacts/runtime-name-aliases.json
!/.codex-localization-tools/artifacts/runtime-name-aliases.tsv
!/.codex-localization-tools/artifacts/runtime-skill-aliases.json
!/.codex-localization-tools/artifacts/runtime-skill-aliases.tsv
!/.codex-localization-tools/artifacts/source-audit.json
!/.codex-localization-tools/artifacts/source-coverage.tsv
!/.codex-localization-tools/artifacts/source-snapshot.json
!/.codex-localization-tools/artifacts/translations.tsv

# Generated or machine-local state must remain ignored even inside allowed trees.
**/.DS_Store
**/__pycache__/
**/*.py[cod]
**/*.pyd
**/bin/
**/obj/
**/NuGet/Migrations/
**/dist/
**/release/
**/archive/
**/payload-stage/
**/self-test-*/
**/release-selftest-*/
**/compatibility-extract-*/
**/*.dll
**/*.exe
**/*.pdb
**/*.zip
**/Payload.sha256
**/Payload.zip
